---
import { generatedMediaCards } from "../content/media-cards";
import { landingSections, type LandingSectionId } from "../content/sections";
import "../styles/global.css";

type SectionContent = {
    kicker: string;
    title: string;
    body: string;
    cards: string[];
};

type FaqItem = {
    question: string;
    answer: string;
};

const sectionContent: Record<LandingSectionId, SectionContent> = {
    hero: {
        kicker: "Patreonic / Creator membership template",
        title: "Turn audience momentum into a membership home.",
        body: "Patreonic gives creator-platform teams a polished, static-first landing page with confident messaging, flexible sections, and room for premium motion when the product is ready for it.",
        cards: [
            "Editorial launch page",
            "Original creator-economy copy",
            "Static-first Astro foundation",
        ],
    },
    audiences: {
        kicker: "Creator types and use cases",
        title: "Shape one message for many creator businesses.",
        body: "Speak to educators, podcasters, video teams, newsletter writers, and community builders without locking the template to one niche.",
        cards: [
            "Course communities",
            "Paid newsletters",
            "Private podcasts",
            "Fan memberships",
        ],
    },
    flow: {
        kicker: "How Patreonic works",
        title: "Explain the path from attention to recurring support.",
        body: "A simple three-step story helps visitors understand how creators package work, invite supporters, and keep their community returning.",
        cards: [
            "Publish a home base",
            "Package member value",
            "Grow with community signals",
        ],
    },
    features: {
        kicker: "Feature showcase",
        title: "Highlight the capabilities a modern membership product needs.",
        body: "Use clear feature blocks for publishing, audience segmentation, community updates, creator analytics, and conversion-focused landing flows.",
        cards: [
            "Creator publishing",
            "Audience insights",
            "Member updates",
            "Launch-ready sections",
        ],
    },
    tiers: {
        kicker: "Membership tier preview",
        title: "Preview value without building checkout logic.",
        body: "Show sample membership levels, benefit framing, and upgrade paths while keeping billing, authentication, and backend systems out of the v1 template.",
        cards: ["Starter circle", "Studio pass", "Inner room"],
    },
    community: {
        kicker: "Community proof",
        title: "Make the product feel active before real customer data exists.",
        body: "Original social-proof modules, creator testimonials, and community prompts provide believable structure that teams can replace with real evidence later.",
        cards: [
            "Creator testimonials",
            "Member activity prompts",
            "Trust-building proof points",
        ],
    },
    faq: {
        kicker: "Frequently asked questions",
        title: "Handle objections before the final ask.",
        body: "Answer practical questions about customization, static performance, visual originality, future motion work, and what is intentionally not included.",
        cards: [
            "Can I customize the copy?",
            "Does this require a backend?",
            "Is the visual direction original?",
        ],
    },
    "final-cta": {
        kicker: "Final CTA / Footer",
        title: "Build a creator membership story that feels ready to ship.",
        body: "Use Patreonic as the fast editorial starting point for a creator-platform landing page, then layer in generated visuals, navigation, and motion in later slices.",
        cards: ["Astro-first", "No copied assets", "Ready for motion slices"],
    },
};

const faqItems: FaqItem[] = [
    {
        question: "Can I customize the copy?",
        answer: "Yes. The starter copy is original placeholder marketing language designed to be replaced with your product positioning, creator segments, and launch proof.",
    },
    {
        question: "Does this require a backend?",
        answer: "No. Patreonic v1 is a static Astro landing template, so billing, authentication, checkout, and CMS data are intentionally outside this slice.",
    },
    {
        question: "Is the visual direction original?",
        answer: "Yes. The template uses generated CSS and HTML primitives with a distinct palette and layout direction rather than copied platform screenshots or assets.",
    },
];

const getInteractionKind = (sectionId: LandingSectionId) => {
    if (sectionId === "tiers") {
        return "tier";
    }

    if (sectionId === "community") {
        return "testimonial";
    }

    if (sectionId === "final-cta") {
        return "final-cta";
    }

    return "card";
};
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>Patreonic — Creator membership landing template</title>
        <meta
            name="description"
            content="Patreonic is an Astro-first landing template for creator-platform and membership SaaS teams."
        />
    </head>
    <body>
        <div
            class="scroll-atmosphere"
            data-scroll-atmosphere
            data-active-theme={landingSections[0].backgroundTheme}
            aria-hidden="true"
        >
        </div>
        <a class="skip-link" href="#main-content">Skip to main content</a>
        <header class="site-header" role="banner" data-header>
            <a class="site-brand" href="#hero" aria-label="Patreonic home">
                Patreonic
            </a>
            <nav class="desktop-nav" aria-label="Primary navigation">
                {
                    landingSections.map((section) => (
                        <div class="nav-item">
                            <a
                                class="nav-link"
                                href={`#${section.id}`}
                                data-section-link={section.id}
                            >
                                {section.navLabel}
                            </a>
                            <div class="nav-menu-panel" data-nav-menu>
                                <span>
                                    {section.backgroundTheme.replace(
                                        "theme-",
                                        "",
                                    )}
                                </span>
                                <strong>{section.navLabel} section</strong>
                            </div>
                        </div>
                    ))
                }
            </nav>
            <button
                class="mobile-menu-toggle"
                type="button"
                aria-controls="mobile-navigation"
                aria-expanded="false"
                data-mobile-menu-toggle
            >
                Menu
            </button>
            <nav
                id="mobile-navigation"
                class="mobile-nav"
                aria-label="Mobile navigation"
                data-mobile-menu
                hidden
            >
                {
                    landingSections.map((section) => (
                        <a
                            class="mobile-nav-link"
                            href={`#${section.id}`}
                            data-section-link={section.id}
                        >
                            {section.navLabel}
                        </a>
                    ))
                }
            </nav>
        </header>
        <main
            id="main-content"
            class="page-shell"
            role="main"
            data-quality-gate="limited-hydration"
            data-performance-budget="static-astro-shell"
        >
            {
                landingSections.map((section) => {
                    const content = sectionContent[section.id];

                    return (
                        <section
                            id={section.id}
                            data-theme={section.backgroundTheme}
                            aria-labelledby={`${section.id}-title`}
                            class={`page-section ${section.id === "hero" ? "hero-section" : ""}`}
                        >
                            <div class="section-copy">
                                <p class="section-kicker">{content.kicker}</p>
                                <h1 id={`${section.id}-title`}>
                                    {content.title}
                                </h1>
                                <p data-essential-content>{content.body}</p>
                                {section.id === "hero" && (
                                    <div
                                        class="hero-actions"
                                        aria-label="Hero calls to action"
                                    >
                                        <a
                                            class="button button-primary"
                                            href="#final-cta"
                                        >
                                            Launch the template
                                        </a>
                                        <a
                                            class="button button-secondary"
                                            href="#audiences"
                                        >
                                            Explore the sections
                                        </a>
                                    </div>
                                )}
                            </div>
                            <div
                                class="section-grid"
                                data-section-kind={section.id}
                                aria-label={`${section.navLabel} highlights`}
                                data-quality-gate="gpu-friendly-motion"
                            >
                                {section.id === "faq" ? (
                                    <div
                                        class="faq-list"
                                        aria-label="Frequently asked questions"
                                    >
                                        {faqItems.map((item) => (
                                            <details
                                                class="faq-panel"
                                                data-faq-panel
                                                data-section-interaction
                                            >
                                                <summary>
                                                    {item.question}
                                                </summary>
                                                <p>{item.answer}</p>
                                            </details>
                                        ))}
                                    </div>
                                ) : (
                                    content.cards.map((card) => (
                                        <article
                                            class="content-card"
                                            tabindex="0"
                                            data-section-interaction
                                            data-interaction-kind={getInteractionKind(
                                                section.id,
                                            )}
                                        >
                                            <span>{card}</span>
                                        </article>
                                    ))
                                )}
                                {section.id === "hero" && (
                                    <div
                                        class="media-collage hero-motion-field"
                                        aria-label="Generated creator media collage"
                                        data-hero-motion-field
                                        data-quality-gate="no-external-assets"
                                    >
                                        {generatedMediaCards.map((card) => (
                                            <article
                                                class={`generated-media-card motion-depth-${card.depth}`}
                                                data-card-variant={card.variant}
                                                data-motion-depth={card.depth}
                                                style={`--resting-x: ${card.restingX}; --resting-y: ${card.restingY};`}
                                            >
                                                <p>{card.eyebrow}</p>
                                                <h2>{card.title}</h2>
                                                <span>{card.detail}</span>
                                            </article>
                                        ))}
                                    </div>
                                )}
                            </div>
                        </section>
                    );
                })
            }
        </main>
        <footer class="site-footer" role="contentinfo">
            <p>
                Patreonic is a static Astro landing template with original
                generated visuals and accessible content structure.
            </p>
        </footer>
        <script>
            import { gsap } from "gsap";

            const header = document.querySelector("[data-header]");
            const mobileToggle = document.querySelector(
                "[data-mobile-menu-toggle]",
            );
            const mobileMenu = document.querySelector("[data-mobile-menu]");
            const focusableMobileMenuItems =
                mobileMenu?.querySelectorAll<HTMLElement>("a, button") ?? [];
            const navLinks = document.querySelectorAll("[data-section-link]");
            const sections = document.querySelectorAll(".page-section[id]");
            const atmosphere = document.querySelector<HTMLElement>(
                "[data-scroll-atmosphere]",
            );
            const heroMotionField = document.querySelector(
                "[data-hero-motion-field]",
            );
            const heroMotionCards = document.querySelectorAll(
                "[data-motion-depth]",
            );
            const sectionInteractionItems =
                document.querySelectorAll<HTMLElement>(
                    "[data-section-interaction]",
                );

            const setHeaderScrollState = () => {
                header?.classList.toggle("is-scrolled", window.scrollY > 24);
            };

            const setActiveSection = (sectionId: string) => {
                navLinks.forEach((link) => {
                    const isActive =
                        link.getAttribute("data-section-link") === sectionId;
                    if (isActive) {
                        link.setAttribute("aria-current", "true");
                    } else {
                        link.removeAttribute("aria-current");
                    }
                });

                const activeSection = document.getElementById(sectionId);
                const activeTheme = activeSection?.getAttribute("data-theme");
                if (activeTheme) {
                    atmosphere?.setAttribute("data-active-theme", activeTheme);
                }
            };

            let previouslyFocusedElement: Element | null = null;

            const setMobileMenuState = (
                isOpen: boolean,
                options: { restoreFocus?: boolean } = {},
            ) => {
                if (isOpen) {
                    previouslyFocusedElement = document.activeElement;
                }

                mobileToggle?.setAttribute("aria-expanded", String(isOpen));
                mobileMenu?.classList.toggle("is-open", isOpen);
                mobileMenu?.toggleAttribute("hidden", !isOpen);
                document
                    .querySelector("main")
                    ?.toggleAttribute("inert", isOpen);

                if (isOpen) {
                    focusableMobileMenuItems[0]?.focus();
                } else if (options.restoreFocus) {
                    (previouslyFocusedElement as HTMLElement | null)?.focus?.();
                    previouslyFocusedElement = null;
                }
            };

            setHeaderScrollState();
            window.addEventListener("scroll", setHeaderScrollState, {
                passive: true,
            });

            const sectionObserver = new IntersectionObserver(
                (entries) => {
                    const visibleSection = entries.find(
                        (entry) => entry.isIntersecting,
                    );
                    if (visibleSection?.target.id) {
                        setActiveSection(visibleSection.target.id);
                    }
                },
                { rootMargin: "-35% 0px -55% 0px", threshold: 0 },
            );

            sections.forEach((section) => sectionObserver.observe(section));
            mobileToggle?.addEventListener("click", () => {
                const isOpen =
                    mobileToggle.getAttribute("aria-expanded") !== "true";
                setMobileMenuState(isOpen);
            });
            navLinks.forEach((link) =>
                link.addEventListener("click", () =>
                    setMobileMenuState(false, { restoreFocus: true }),
                ),
            );
            window.addEventListener("keydown", (event) => {
                if (event.key === "Escape") {
                    setMobileMenuState(false, { restoreFocus: true });
                }

                if (
                    mobileToggle?.getAttribute("aria-expanded") === "true" &&
                    event.key === "Tab" &&
                    focusableMobileMenuItems.length > 0
                ) {
                    const firstItem = focusableMobileMenuItems[0];
                    const lastItem =
                        focusableMobileMenuItems[
                            focusableMobileMenuItems.length - 1
                        ];

                    if (
                        event.shiftKey &&
                        document.activeElement === firstItem
                    ) {
                        event.preventDefault();
                        lastItem.focus();
                    } else if (
                        !event.shiftKey &&
                        document.activeElement === lastItem
                    ) {
                        event.preventDefault();
                        firstItem.focus();
                    }
                }

                if (event.key === "Home") {
                    focusableMobileMenuItems[0]?.focus();
                }

                if (event.key === "End") {
                    focusableMobileMenuItems[
                        focusableMobileMenuItems.length - 1
                    ]?.focus();
                }

                if (event.key === "Enter" || event.key === " ") {
                    document.activeElement?.dispatchEvent(
                        new Event("click", { bubbles: true }),
                    );
                }
            });

            const finePointer = matchMedia("(pointer: fine)");
            const reducedMotion = matchMedia(
                "(prefers-reduced-motion: reduce)",
            );

            sectionInteractionItems.forEach((item) => {
                item.addEventListener("pointerdown", () => {
                    item.classList.add("is-pressed");
                });
                item.addEventListener("pointerup", () => {
                    item.classList.remove("is-pressed");
                });
                item.addEventListener("pointercancel", () => {
                    item.classList.remove("is-pressed");
                });
                item.addEventListener("pointerleave", () => {
                    item.classList.remove("is-pressed");
                });
            });

            if (!reducedMotion.matches) {
                const sectionInteractionObserver = new IntersectionObserver(
                    (entries) => {
                        entries.forEach((entry) => {
                            if (entry.isIntersecting) {
                                gsap.fromTo(
                                    entry.target,
                                    { autoAlpha: 0, y: 22 },
                                    {
                                        autoAlpha: 1,
                                        y: 0,
                                        duration: 0.58,
                                        ease: "power3.out",
                                    },
                                );
                                sectionInteractionObserver.unobserve(
                                    entry.target,
                                );
                            }
                        });
                    },
                    { rootMargin: "0px 0px -12% 0px", threshold: 0.18 },
                );

                sectionInteractionItems.forEach((item) =>
                    sectionInteractionObserver.observe(item),
                );
            }

            let atmosphereFrame = 0;

            const updateAtmosphereProgress = () => {
                atmosphereFrame = 0;

                if (!atmosphere || reducedMotion.matches) {
                    return;
                }

                const scrollableDistance =
                    document.documentElement.scrollHeight - window.innerHeight;
                const progress =
                    scrollableDistance > 0
                        ? window.scrollY / scrollableDistance
                        : 0;

                atmosphere.style.setProperty(
                    "--atmosphere-progress",
                    progress.toFixed(3),
                );
                atmosphere.style.setProperty(
                    "--atmosphere-drift",
                    `${Math.round(progress * 80)}px`,
                );
            };

            const scheduleAtmosphereProgress = () => {
                if (!atmosphereFrame) {
                    atmosphereFrame = requestAnimationFrame(
                        updateAtmosphereProgress,
                    );
                }
            };

            updateAtmosphereProgress();
            window.addEventListener("scroll", scheduleAtmosphereProgress, {
                passive: true,
            });

            const motionDepthSettings = {
                foreground: { movement: 28, tilt: 7 },
                midground: { movement: 16, tilt: 4 },
                background: { movement: 8, tilt: 2 },
            };

            const setHeroMotionToRest = () => {
                heroMotionCards.forEach((card) => {
                    gsap.to(card, {
                        "--motion-x": "0px",
                        "--motion-y": "0px",
                        "--motion-tilt-x": "0deg",
                        "--motion-tilt-y": "0deg",
                        duration: 0.8,
                        ease: "power3.out",
                    });
                });
            };

            if (
                heroMotionField &&
                finePointer.matches &&
                !reducedMotion.matches
            ) {
                heroMotionField.addEventListener("pointermove", (event) => {
                    const pointerEvent = event as PointerEvent;
                    const bounds = heroMotionField.getBoundingClientRect();
                    const xProgress =
                        (pointerEvent.clientX - bounds.left) / bounds.width -
                        0.5;
                    const yProgress =
                        (pointerEvent.clientY - bounds.top) / bounds.height -
                        0.5;

                    heroMotionCards.forEach((card) => {
                        const depth =
                            card.getAttribute("data-motion-depth") ??
                            "background";
                        const settings =
                            motionDepthSettings[
                                depth as keyof typeof motionDepthSettings
                            ] ?? motionDepthSettings.background;

                        gsap.to(card, {
                            "--motion-x": `${xProgress * settings.movement}px`,
                            "--motion-y": `${yProgress * settings.movement}px`,
                            "--motion-tilt-x": `${yProgress * settings.tilt * -1}deg`,
                            "--motion-tilt-y": `${xProgress * settings.tilt}deg`,
                            duration: 0.55,
                            ease: "power3.out",
                        });
                    });
                });

                heroMotionField.addEventListener(
                    "pointerleave",
                    setHeroMotionToRest,
                );
            } else {
                setHeroMotionToRest();
            }
        </script>
    </body>
</html>
